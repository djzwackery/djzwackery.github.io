# DJ Zwackery: environment variables (build/CI only, never exposed to the browser)
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# In CI these are provided as GitHub repo secrets (see refresh-feed.yml).

# YouTube Data API v3 key. Create one at:
# https://console.cloud.google.com/apis/credentials  (enable "YouTube Data API v3")
YOUTUBE_API_KEY=

# Optional overrides (defaults shown):
# YOUTUBE_CHANNEL_ID=UCLIVVSFSj9kbYUJzGYIjiUg
# YOUTUBE_MAX_RESULTS=12
