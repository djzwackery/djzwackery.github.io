---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import Marquee from "../components/Marquee.astro";
import BackgroundVideo from "../components/BackgroundVideo.astro";
import SocialRail from "../components/SocialRail.astro";
import Logo from "../components/Logo.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import CoffeeIcon from "../components/CoffeeIcon.astro";
import jivesFace from "../assets/bigjimjimo.webp";
import { DJ_NAME, KOFI_URL } from "../config";
import { useTranslations, getLang } from "../i18n";
import { localeTags } from "../i18n/ui";
import { getEmotes } from "../lib/emotes";

/**
 * Zwackery's Twitch + 7TV emotes, fetched and self-hosted at build time (see
 * lib/emotes.ts), grouped by source so the client can weight them and
 * handed over as plain local URLs, no runtime fetch, no third-party host.
 */
const emotes = await getEmotes();
const emotePayload = {
  twitch: emotes
    .filter((e) => e.source === "twitch")
    .map((e) => `/emotes/${e.file}`),
  seventv: emotes
    .filter((e) => e.source === "seventv")
    .map((e) => `/emotes/${e.file}`),
};

interface VideoLD {
  id: string;
  title: string;
  thumb: string;
  published: string;
}
interface Props {
  /**
   * Optional title override; omit to use the localized default.
   */
  title?: string;
  /**
   * Optional description override; omit to use the localized default.
   */
  description?: string;
  videos?: VideoLD[];
  /**
   * False on the 404 page: noindex and no hreflang alternates.
   */
  index?: boolean;
  /**
   * False on the press page: it should read the same whether or not
   * Zwackery happens to be live right now, so the Twitch live-poll is
   * skipped entirely and the marquee/background stay in their idle state.
   */
  liveAware?: boolean;
  /**
   * True on the press page: swaps the looping ambient video for the static
   * scrim only, since a promoter grabbing assets shouldn't get a looping
   * background video.
   */
  staticBackground?: boolean;
}
const {
  title,
  description,
  videos = [],
  index = true,
  liveAware = true,
  staticBackground = false,
} = Astro.props;
const year = new Date().getFullYear();
const t = useTranslations(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const homeUrl = getRelativeLocaleUrl(lang);
const isHome = Astro.url.pathname === homeUrl;
/**
 * Only /press exists as a secondary route today; generalize this and the
 * JSON-LD it feeds in Seo.astro if a second one shows up.
 */
const breadcrumb = isHome
  ? null
  : [
      { name: DJ_NAME, path: homeUrl },
      {
        name: t("footer.press"),
        path: getRelativeLocaleUrl(lang, "press"),
      },
    ];
---

<!doctype html>
<html
  lang={localeTags[lang]}
  data-live="false"
  data-live-aware={liveAware ? null : "false"}
>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /**
       * Root-only redirect, in priority order: an explicit choice from the
       * language switcher (set in LangSwitcher.astro) always wins and persists
       * indefinitely; otherwise a first-visit-only device-language guess, gated
       * so it never fires more than once. Supported list mirrors
       * astro.config.mjs's locales.
       */
      (function () {
        try {
          const PREF_KEY = "zw-lang-pref";
          const REDIRECTED_KEY = "zw-lang-redirected";
          const supported = ["ja", "de", "nl", "fr", "it"];

          if (location.pathname !== "/") {
            localStorage.setItem(REDIRECTED_KEY, "1");
            return;
          }

          const pref = localStorage.getItem(PREF_KEY);
          if (pref) {
            if (pref !== "en" && supported.indexOf(pref) !== -1) {
              location.replace("/" + pref + "/");
            }
            return;
          }

          if (localStorage.getItem(REDIRECTED_KEY)) {
            return;
          }
          localStorage.setItem(REDIRECTED_KEY, "1");
          const detected = (
            (navigator.languages && navigator.languages[0]) ||
            navigator.language ||
            ""
          )
            .split("-")[0]
            .toLowerCase();
          if (supported.indexOf(detected) !== -1) {
            location.replace("/" + detected + "/");
          }
        } catch {
          /* localStorage unavailable (private browsing restriction); skip redirect */
        }
      })();
    </script>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {
      lang === "nl" && (
        <link rel="preload" as="image" href="/dutch.webp" fetchpriority="low" />
      )
    }
    <Seo
      title={title}
      description={description}
      videos={videos}
      index={index}
      breadcrumb={breadcrumb}
    />
  </head>
  <body>
    <a class="skip-link" href="#videos">{t("a11y.skipToSets")}</a>
    <BackgroundVideo video={!staticBackground} />
    <Marquee />

    <main id="main">
      {breadcrumb && <Breadcrumb items={breadcrumb} />}
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__top">
          {
            isHome ? (
              <Logo class="footer__logo" title={DJ_NAME} />
            ) : (
              <a
                class="footer__logo"
                href={homeUrl}
                aria-label={t("a11y.backHome")}
              >
                <Logo title={DJ_NAME} />
              </a>
            )
          }
          <SocialRail />
        </div>
        <div class="footer__meta">
          <div class="footer__meta-left">
            <p class="footer__copy">
              © {year}
              {" " + DJ_NAME}
            </p>
            {
              KOFI_URL && (
                <a
                  class="footer__kofi"
                  href={KOFI_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <CoffeeIcon />
                  {t("footer.tip")}
                </a>
              )
            }
            <LangSwitcher />
          </div>
          <a
            class="footer__credit"
            href="https://jamesiv.es"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="footer__credit-swap">
              <span class="footer__credit-txt is-default"
                >{t("footer.siteBy", { name: "Jives" })}</span
              >
              <span class="footer__credit-txt is-alt" aria-hidden="true"
                >{t("footer.siteBy", { name: "BIG JIM" })}</span
              >
            </span>
            <Image
              src={jivesFace}
              alt="Jives"
              width={28}
              height={28}
              loading="lazy"
            />
          </a>
        </div>
        <p class="footer__press-row">
          <a class="footer__link" href={getRelativeLocaleUrl(lang, "press")}>
            {t("footer.press")}
          </a>
        </p>
        <p class="footer__disclaimer">{t("footer.disclaimer")}</p>
      </div>
    </footer>

    <div id="emote-rain" aria-hidden="true"></div>

    <script
      type="application/json"
      data-emotes
      is:inline
      set:html={JSON.stringify(emotePayload)}
    />

    <div class="toast" data-toast role="status" aria-live="polite">
      {t("toast.notFound")}
    </div>

    <div
      class="lightbox"
      id="lightbox"
      role="dialog"
      aria-modal="true"
      aria-label={t("a11y.videoPlayer")}
    >
      <button
        class="lightbox__close"
        id="lightbox-close"
        aria-label={t("a11y.closeVideo")}>✕ {t("a11y.close")}</button
      >
      <div class="lightbox__stage">
        <div class="lightbox__bloom" aria-hidden="true"></div>
        <div class="lightbox__frame" id="lightbox-frame"></div>
      </div>
    </div>

    <script src="../scripts/app.ts"></script>
  </body>
</html>
