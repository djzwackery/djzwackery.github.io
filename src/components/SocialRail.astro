---

<ul class="socials" role="list">
  {
    SOCIALS.map((s) => (
      <li>
        <a
          class="social"
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          style={`--accent: var(${s.accent})`}
          aria-label={`${s.label} ${t("a11y.newTab")}`}
        >
          <span class="social__chip">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={ICONS[s.platform]} />
            </svg>
          </span>
          <span class="social__label">{s.label}</span>
        </a>
      </li>
    ))
  }
</ul>
