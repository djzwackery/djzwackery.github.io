---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { load as parseYaml } from "js-yaml";
import { useTranslations, getLang, highlight } from "../i18n";

const t = useTranslations(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const dateLocale = lang === "en" ? "en-AU" : lang;

interface Gig {
  date: string;
  event?: string;
  venue?: string;
  location: string;
  url?: string;
}

const today = new Date();
today.setHours(0, 0, 0, 0);

const raw = readFileSync(resolve("config/gigs.yaml"), "utf8");
const upcoming = ((parseYaml(raw) as Gig[] | null) ?? [])
  .filter((g) => new Date(g.date) >= today)
  .sort((a, b) => a.date.localeCompare(b.date));

/**
 * Format an ISO date into a big day number and short month for the date tile.
 */
function fmt(iso: string) {
  const d = new Date(iso);
  return {
    day: d.toLocaleDateString(dateLocale, { day: "2-digit" }),
    mon: d.toLocaleDateString(dateLocale, { month: "short" }).toUpperCase(),
  };
}

/**
 * Full date (with year) for the tile's `title`; the tile itself omits the year to stay compact.
 */
function fullDate(iso: string) {
  return new Date(iso).toLocaleDateString(dateLocale, {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}
---

{
  upcoming.length > 0 && (
    <section class="section wrap gigs" id="gigs" aria-labelledby="gigs-head">
      <div class="section__head">
        <h2
          class="screamer"
          id="gigs-head"
          set:html={highlight(t("gigs.heading"))}
        />
      </div>

      <ul class="gig-list">
        {upcoming.map((g) => {
          const { day, mon } = fmt(g.date);
          const hasEvent = Boolean(g.event);
          const hasVenue = Boolean(g.venue);
          return (
            <li class="gig">
              <time
                class="gig__date"
                datetime={g.date}
                title={fullDate(g.date)}
              >
                <span class="gig__day">{day}</span>
                <span class="gig__mon">{mon}</span>
              </time>
              <div class="gig__info">
                {(hasEvent || hasVenue) && (
                  <span class="gig__venue">
                    {hasEvent ? g.event : g.venue}
                    {hasEvent && hasVenue && (
                      <span class="gig__venue-sub"> • {g.venue}</span>
                    )}
                  </span>
                )}
                <span class="gig__location">{g.location}</span>
              </div>
              {g.url ? (
                <a
                  class="btn btn--magenta gig__cta"
                  href={g.url}
                  target="_blank"
                  rel="noopener"
                >
                  {t("gigs.details")}
                </a>
              ) : (
                <span class="gig__tba">{t("gigs.onSale")}</span>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )
}
