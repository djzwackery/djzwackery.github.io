---
import { Picture } from "astro:assets";
import { useTranslations, highlight } from "../i18n";
import pose from "../assets/zwack-pose.png";
import poseAlt from "../assets/zwack-pose-2.png";

const t = useTranslations(Astro.currentLocale);

const facts = [
  t("about.location"),
  "Hardcore",
  "150+ BPM",
  t("about.twitchPartner"),
];
---

<section class="section wrap about" id="about" aria-labelledby="about-head">
  <div class="section__head">
    <h2
      class="screamer"
      id="about-head"
      set:html={highlight(t("about.heading"))}
    />
  </div>

  <div class="about__grid">
    <div class="about__body">
      <p class="about__lead">{t("about.bio1")}</p>
      <p class="about__text">{t("about.bio2")}</p>
      <ul class="about__facts">
        {
          facts.map((f) => (
            <li>
              {f}
              {f === t("about.twitchPartner") && (
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 16 16"
                  aria-label={t("about.verifiedPartner")}
                >
                  <path
                    fill="oklch(66.99% 0.2053 299.17)"
                    fill-rule="evenodd"
                    d="M12.5 3.5 8 2 3.5 3.5 2 8l1.5 4.5L8 14l4.5-1.5L14 8l-1.5-4.5ZM7 11l4.5-4.5L10 5 7 8 5.5 6.5 4 8l3 3Z"
                    clip-rule="evenodd"
                  />
                </svg>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about__mascot" aria-hidden="true" data-mascot>
      <div class="about__mascot-frame">
        <Picture
          class="is-default"
          src={pose}
          alt=""
          widths={[200, 320, 480, 640]}
          sizes="(min-width: 900px) 360px, min(640px, 100vw - 2.5rem)"
          formats={["avif", "webp"]}
          loading="lazy"
          draggable="false"
        />
        <Picture
          class="is-alt"
          src={poseAlt}
          alt=""
          widths={[200, 320, 480, 640]}
          sizes="(min-width: 900px) 360px, min(640px, 100vw - 2.5rem)"
          formats={["avif", "webp"]}
          loading="lazy"
          draggable="false"
        />
      </div>
    </div>
  </div>
</section>
