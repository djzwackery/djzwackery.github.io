---
import HomeIcon from "./HomeIcon.astro";
import { useTranslations } from "../i18n";

interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<nav class="breadcrumb wrap" aria-label={t("a11y.breadcrumb")}>
  <ol class="breadcrumb__list">
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class="breadcrumb__item">
            {isLast ? (
              <span class="breadcrumb__current" aria-current="page">
                {item.name}
              </span>
            ) : i === 0 ? (
              <a
                class="breadcrumb__link breadcrumb__link--home"
                href={item.path}
                aria-label={t("a11y.backHome")}
              >
                <HomeIcon class="breadcrumb__icon" />
              </a>
            ) : (
              <a class="breadcrumb__link" href={item.path}>
                {item.name}
              </a>
            )}
            {!isLast && (
              <span class="breadcrumb__sep" aria-hidden="true">
                ◆
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
