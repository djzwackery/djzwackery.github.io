---
import { MARQUEE_WORDS, MARQUEE_FOLLOW_TWITCH_TOKEN } from "../config";
import { useTranslations, getLang } from "../i18n";
import { marqueeLive } from "../i18n/ui";

const t = useTranslations(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);

const idleWords = MARQUEE_WORDS.map((w) =>
  w === MARQUEE_FOLLOW_TWITCH_TOKEN ? t("hero.followTwitch").toUpperCase() : w,
);
const liveWordsOnce = [
  `● ${t("status.live").toUpperCase()}`,
  ...marqueeLive[lang],
];

/**
 * The word lists are duplicated inline so the -50% keyframe loops seamlessly.
 */
const words = [...idleWords, ...idleWords];
const liveWords = [
  ...liveWordsOnce,
  ...liveWordsOnce,
  ...liveWordsOnce,
  ...liveWordsOnce,
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track marquee__track--idle">
    {words.map((w) => <span>{w}</span>)}
  </div>
  <div class="marquee__track marquee__track--live">
    {liveWords.map((w) => <span>{w}</span>)}
  </div>
</div>
