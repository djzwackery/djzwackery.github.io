---
import VideoCard from "./VideoCard.astro";
import { useTranslations, highlight } from "../i18n";

interface Video {
  id: string;
  title: string;
  thumb: string;
  published: string;
  viewCount: number;
}
interface Props {
  videos: Video[];
}
const { videos } = Astro.props;
const t = useTranslations(Astro.currentLocale);

/**
 * Stop calling it "new" once nothing's been uploaded in a while.
 */
const NEW_BADGE_WINDOW_DAYS = 30;
const latestIsRecent =
  videos.length > 0 &&
  (Date.now() - new Date(videos[0].published).getTime()) / 86400000 <=
    NEW_BADGE_WINDOW_DAYS;
---

<section class="section wrap" id="videos" aria-labelledby="videos-head">
  <div class="section__head">
    <h2
      class="screamer"
      id="videos-head"
      set:html={highlight(t("videos.heading"))}
    />
  </div>

  {
    videos.length > 0 ? (
      <div class="wall">
        {videos.map((v, i) => (
          <VideoCard
            id={v.id}
            title={v.title}
            thumb={v.thumb}
            published={v.published}
            viewCount={v.viewCount}
            isLatest={i === 0 && latestIsRecent}
          />
        ))}
      </div>
    ) : (
      <p class="hero__tagline">{t("videos.empty")}</p>
    )
  }
</section>
