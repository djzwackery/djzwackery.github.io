---
import { Picture } from "astro:assets";
import Logo from "./Logo.astro";
import { TWITCH_URL, YOUTUBE_URL } from "../config";
import { useTranslations } from "../i18n";

import fire from "../assets/hero-1-fire.jpg";
import wall from "../assets/hero-2-wall.jpg";
import magenta from "../assets/hero-3-magenta.jpg";
import handsup from "../assets/hero-4-handsup.jpg";

const t = useTranslations(Astro.currentLocale);

/**
 * The hero photo deck. Rendered back-to-front and auto-shuffled by the
 * client script so every shot takes a turn at the front.
 */
const shots = [
  { src: handsup, alt: t("hero.photo1Alt") },
  { src: magenta, alt: t("hero.photo2Alt") },
  { src: wall, alt: t("hero.photo3Alt") },
  { src: fire, alt: t("hero.photo4Alt") },
];
---

<section class="hero wrap" aria-labelledby="wordmark">
  <div class="hero__intro">
    <div class="hero__eyebrow">
      <p class="hero__kicker">{t("hero.kicker")}</p>
      <p class="status" data-status>
        <span class="status__dot"></span>
        <span class="status__text status__text--offline"
          >{t("status.offline")}</span
        >
        <span class="status__text status__text--live">{t("status.live")}</span>
      </p>
    </div>
    <h1 class="hero__wordmark" id="wordmark" data-party>
      <Logo class="logo" title="DJ Zwackery" />
      <span class="visually-hidden">DJ Zwackery</span>
    </h1>
    <p class="hero__tagline">{t("hero.tagline")}</p>

    <div class="hero__actions">
      <a
        class="btn btn--magenta"
        href={TWITCH_URL}
        target="_blank"
        rel="noopener"
      >
        {t("hero.followTwitch")}
      </a>
      <a
        class="btn btn--cyan"
        href={YOUTUBE_URL}
        target="_blank"
        rel="noopener"
      >
        {t("hero.subscribeYoutube")}
      </a>
    </div>
    <a class="hero__jump" href="#videos">
      {t("hero.watchSets")}<span aria-hidden="true">↓</span>
    </a>
  </div>

  <div class="hero__fan" data-hero-fan aria-label={t("hero.fanAriaLabel")}>
    {
      shots.map((s, i) => (
        <Picture
          pictureAttributes={{ class: "fan__photo" }}
          src={s.src}
          alt={i === shots.length - 1 ? s.alt : ""}
          widths={[400, 520, 700, 950, 1300, 1700]}
          sizes="(max-width: 640px) 92vw, (max-width: 1040px) 42vw, 40vw"
          quality={75}
          formats={["avif", "webp"]}
          loading={i >= shots.length - 2 ? "eager" : "lazy"}
          fetchpriority={i === shots.length - 1 ? "high" : undefined}
        />
      ))
    }
  </div>
</section>
