---
import { useTranslations, getLang } from "../i18n";

interface Props {
  id: string;
  title: string;
  thumb: string;
  published: string;
  viewCount: number;
  duration: string;
  isLatest?: boolean;
}
const {
  id,
  title,
  thumb,
  published,
  viewCount,
  duration,
  isLatest = false,
} = Astro.props;

const t = useTranslations(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);
const dateLocale = lang === "en" ? "en-AU" : lang;

const absoluteDate = new Date(published).toLocaleDateString(dateLocale, {
  day: "numeric",
  month: "short",
  year: "numeric",
});

/**
 * "2 days ago", localized; matches how YouTube itself timestamps videos.
 */
function relativeDate(iso: string): string {
  const rtf = new Intl.RelativeTimeFormat(dateLocale, { numeric: "auto" });
  const diffSeconds = (new Date(iso).getTime() - Date.now()) / 1000;
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ["year", 31536000],
    ["month", 2592000],
    ["week", 604800],
    ["day", 86400],
    ["hour", 3600],
    ["minute", 60],
  ];
  for (const [unit, secondsInUnit] of units) {
    if (Math.abs(diffSeconds) >= secondsInUnit) {
      return rtf.format(Math.round(diffSeconds / secondsInUnit), unit);
    }
  }
  return rtf.format(Math.round(diffSeconds), "second");
}

const relative = relativeDate(published);

/**
 * ISO-8601 duration (e.g. "PT1H42M18S") to "h:mm:ss"/"m:ss". YouTube always
 * includes hours as a single digit, so this doesn't need to pad hours.
 */
function formatDuration(iso: string): string | null {
  const match = /^PT(?:(\d+)H)?(?:(\d+)M)?(?:(\d+)S)?$/.exec(iso);
  if (!match) {
    return null;
  }
  const hours = Number(match[1] ?? 0);
  const minutes = Number(match[2] ?? 0);
  const seconds = Number(match[3] ?? 0);
  const pad = (n: number) => String(n).padStart(2, "0");
  return hours > 0
    ? `${hours}:${pad(minutes)}:${pad(seconds)}`
    : `${minutes}:${pad(seconds)}`;
}

const formattedDuration = duration ? formatDuration(duration) : null;
const views =
  viewCount > 0
    ? t("videos.views", {
        count: new Intl.NumberFormat(dateLocale, {
          notation: "compact",
          compactDisplay: "short",
        }).format(viewCount),
      })
    : null;
---

<a
  class="card"
  href={`https://www.youtube.com/watch?v=${id}`}
  data-video-id={id}
>
  <span class="visually-hidden">{t("videos.play")}: </span>
  <span class="card__thumb">
    <img
      src={thumb}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
    />
    {
      isLatest && (
        <span class="card__badge" aria-hidden="true">
          {t("videos.new")}
        </span>
      )
    }
    {
      formattedDuration && (
        <span class="card__duration" aria-hidden="true">
          {formattedDuration}
        </span>
      )
    }
    <span class="card__play" aria-hidden="true">
      <svg viewBox="0 0 100 100">
        <circle
          cx="50"
          cy="50"
          r="46"
          fill="var(--magenta)"
          stroke="var(--void)"
          stroke-width="5"></circle>
        <path d="M42 33 L72 50 L42 67 Z" fill="var(--void)"></path>
      </svg>
    </span>
  </span>
  <span class="card__body">
    <span class="card__title">{title}</span>
    <span class="card__meta">
      {views && <span class="card__views">{views} · </span>}
      <time datetime={published} title={absoluteDate}>{relative}</time>
    </span>
  </span>
</a>
