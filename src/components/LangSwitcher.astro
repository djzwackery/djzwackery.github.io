---
import { getRelativeLocaleUrl } from "astro:i18n";
import { languages } from "../i18n/ui";
import { getLang, useTranslations } from "../i18n";
import Flag from "./Flag.astro";

const current = getLang(Astro.currentLocale);
const t = useTranslations(Astro.currentLocale);
---

<details class="langs" data-langs>
  <summary class="langs__current" aria-label={t("a11y.language")}>
    <Flag lang={current} />
    <span class="langs__code">{current}</span>
    <span class="langs__caret" aria-hidden="true"></span>
  </summary>
  <ul class="langs__menu" role="list">
    {
      Object.entries(languages).map(([code, label]) => (
        <li>
          <a
            class:list={["langs__opt", { "is-current": code === current }]}
            href={getRelativeLocaleUrl(code)}
            hreflang={code}
            aria-current={code === current ? "true" : undefined}
          >
            <Flag lang={code as keyof typeof languages} />
            <span>{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script>
  /**
   * Progressive enhancement: close the language popover on outside click or
   * Escape. It still opens/closes and navigates fine without JS.
   */
  const el = document.querySelector<HTMLDetailsElement>("[data-langs]");
  if (el) {
    document.addEventListener("click", (e) => {
      if (el.open && !el.contains(e.target as Node)) el.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && el.open) el.open = false;
    });
  }
</script>
