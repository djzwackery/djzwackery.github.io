---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { load as parseYaml } from "js-yaml";
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from "astro:i18n";
import {
  SITE_URL,
  DJ_NAME,
  SHOW_NAME,
  SOCIALS,
  SAME_AS_EXTRA,
  TWITTER_HANDLE,
  BOOKING_EMAIL,
} from "../config";
import { useTranslations, getLang } from "../i18n";
import { languages } from "../i18n/ui";

interface VideoLD {
  id: string;
  title: string;
  thumb: string;
  published: string;
  /**
   * ISO-8601 (e.g. "PT4M13S"); omitted from the JSON-LD entirely if empty.
   */
  duration?: string;
  /**
   * Omitted from the JSON-LD entirely if empty.
   */
  description?: string;
  /**
   * Omitted from the JSON-LD entirely if 0/unset.
   */
  viewCount?: number;
}
interface GigLD {
  date: string;
  event?: string;
  venue?: string;
  location: string;
  url?: string;
  /**
   * Must be a fully-qualified URL to an externally-hosted flyer/poster; no local asset pipeline for this.
   */
  image?: string;
  /**
   * The promoter/event brand, when it isn't Zwackery himself; omitted from the JSON-LD if unset.
   */
  organizer?: string;
}
interface Props {
  /**
   * Overrides the default localized title (used by the 404 page).
   */
  title?: string;
  videos?: VideoLD[];
  /**
   * Whether to emit hreflang alternates and structured data (false on 404).
   */
  index?: boolean;
}

const { title: titleOverride, videos = [], index = true } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);

const title = titleOverride ?? `${DJ_NAME} · ${SHOW_NAME} · ${t("meta.role")}`;
const description = t("meta.description");
const ogImage = new URL("/meta.png", SITE_URL).href;

const isHome = index && Astro.url.pathname === getRelativeLocaleUrl(lang);
const canonical = isHome
  ? getAbsoluteLocaleUrl(lang)
  : new URL(Astro.url.pathname, SITE_URL).href;

const ogLocale: Record<string, string> = {
  en: "en_US",
  ja: "ja_JP",
  de: "de_DE",
  nl: "nl_NL",
  fr: "fr_FR",
};
const otherLocales = Object.keys(languages).filter((code) => code !== lang);

const today = new Date();
today.setHours(0, 0, 0, 0);
const upcomingGigs = index
  ? (
      (parseYaml(readFileSync(resolve("config/gigs.yaml"), "utf8")) as
        GigLD[] | null) ?? []
    ).filter((g) => new Date(g.date) >= today)
  : [];

const musicGroupLD = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: DJ_NAME,
  description: t("meta.description"),
  genre: ["Happy Hardcore", "UK Hardcore", "Hardcore", "Harder Styles"],
  url: SITE_URL,
  image: ogImage,
  foundingLocation: {
    "@type": "Place",
    name: "Melbourne, Australia",
  },
  email: BOOKING_EMAIL,
  sameAs: [...SOCIALS.map((s) => s.url), ...SAME_AS_EXTRA],
};

const eventLD = upcomingGigs.map((g) => {
  const label = [g.event, g.venue].filter(Boolean).join(" • ") || g.location;
  return {
    "@context": "https://schema.org",
    "@type": "MusicEvent",
    name: `${DJ_NAME} at ${label}`,
    startDate: g.date,
    eventStatus: "https://schema.org/EventScheduled",
    eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
    location: {
      "@type": "Place",
      name: g.venue ?? g.event ?? g.location,
      address: {
        "@type": "PostalAddress",
        addressLocality: g.location,
      },
    },
    performer: {
      "@type": "MusicGroup",
      name: DJ_NAME,
      url: SITE_URL,
      image: ogImage,
    },
    ...(g.organizer
      ? { organizer: { "@type": "Organization", name: g.organizer } }
      : {}),
    ...(g.url ? { url: g.url } : {}),
    ...(g.image?.startsWith("http") ? { image: g.image } : {}),
    ...(g.url
      ? {
          offers: {
            "@type": "Offer",
            url: g.url,
            availability: "https://schema.org/InStock",
          },
        }
      : {}),
  };
});

const videoLD =
  videos.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        itemListElement: videos.slice(0, 12).map((v, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "VideoObject",
            name: v.title,
            thumbnailUrl: v.thumb,
            uploadDate: v.published,
            contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
            embedUrl: `https://www.youtube.com/embed/${v.id}`,
            creator: { "@type": "MusicGroup", name: DJ_NAME, url: SITE_URL },
            ...(v.duration ? { duration: v.duration } : {}),
            ...(v.description ? { description: v.description } : {}),
            ...(v.viewCount
              ? {
                  interactionStatistic: {
                    "@type": "InteractionCounter",
                    interactionType: "https://schema.org/WatchAction",
                    userInteractionCount: v.viewCount,
                  },
                }
              : {}),
          },
        })),
      }
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={DJ_NAME} />
<meta
  name="keywords"
  content="DJ Zwackery, House of Fun, hardcore DJ, happy hardcore, UK hardcore, harder styles, Melbourne DJ, Twitch DJ, rave"
/>
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#ff1f8f" />
<meta name="color-scheme" content="dark" />
{
  index ? (
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
  ) : (
    <meta name="robots" content="noindex" />
  )
}

{
  isHome && (
    <>
      {Object.keys(languages).map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={getAbsoluteLocaleUrl(code)}
        />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={getAbsoluteLocaleUrl("en")}
      />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={DJ_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={`${DJ_NAME} — ${SHOW_NAME} · ${t("meta.role")}`}
/>
<meta property="og:locale" content={ogLocale[lang]} />
{
  otherLocales.map((code) => (
    <meta property="og:locale:alternate" content={ogLocale[code]} />
  ))
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta
  name="twitter:image:alt"
  content={`${DJ_NAME} — ${SHOW_NAME} · ${t("meta.role")}`}
/>

<link rel="preconnect" href="https://i.ytimg.com" />
<link rel="preconnect" href="https://player.twitch.tv" />
<link rel="preconnect" href="https://7tv.io" />
<link rel="dns-prefetch" href="https://cdn.7tv.app" />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(musicGroupLD)}
/>
{
  eventLD.map((e) => (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(e)} />
  ))
}
{
  videoLD && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(videoLD)}
    />
  )
}
