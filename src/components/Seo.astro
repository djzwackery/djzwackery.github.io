---
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from "astro:i18n";
import { SITE_URL, DJ_NAME, SHOW_NAME, SOCIALS } from "../config";
import { useTranslations, getLang } from "../i18n";
import { languages } from "../i18n/ui";

interface VideoLD {
  id: string;
  title: string;
  thumb: string;
  published: string;
}
interface Props {
  /** Overrides the default localized title (used by the 404 page). */
  title?: string;
  videos?: VideoLD[];
  /** Whether to emit hreflang alternates (only true for the home page). */
  index?: boolean;
}

const { title: titleOverride, videos = [], index = true } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const lang = getLang(Astro.currentLocale);

const title = titleOverride ?? `${DJ_NAME} · ${SHOW_NAME} · ${t("meta.role")}`;
const description = t("meta.description");
const ogImage = new URL("/og.png", SITE_URL).href;

/** hreflang alternates and canonical only make sense for the home page. */
const isHome = index && Astro.url.pathname === getRelativeLocaleUrl(lang);
const canonical = isHome
  ? getAbsoluteLocaleUrl(lang)
  : new URL(Astro.url.pathname, SITE_URL).href;

const ogLocale: Record<string, string> = {
  en: "en_US",
  ja: "ja_JP",
  de: "de_DE",
  nl: "nl_NL",
  fr: "fr_FR",
};
const otherLocales = Object.keys(languages).filter((code) => code !== lang);

const personLD = {
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  name: DJ_NAME,
  genre: ["Happy Hardcore", "UK Hardcore"],
  url: SITE_URL,
  sameAs: SOCIALS.map((s) => s.url),
};

const videoLD =
  videos.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "ItemList",
        itemListElement: videos.slice(0, 12).map((v, i) => ({
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "VideoObject",
            name: v.title,
            thumbnailUrl: v.thumb,
            uploadDate: v.published,
            contentUrl: `https://www.youtube.com/watch?v=${v.id}`,
            embedUrl: `https://www.youtube.com/embed/${v.id}`,
          },
        })),
      }
    : null;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#ff1f8f" />
{!index && <meta name="robots" content="noindex" />}

{
  isHome && (
    <>
      {Object.keys(languages).map((code) => (
        <link
          rel="alternate"
          hreflang={code}
          href={getAbsoluteLocaleUrl(code)}
        />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={getAbsoluteLocaleUrl("en")}
      />
    </>
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={DJ_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={ogLocale[lang]} />
{
  otherLocales.map((code) => (
    <meta property="og:locale:alternate" content={ogLocale[code]} />
  ))
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="preconnect" href="https://i.ytimg.com" />
<link rel="preconnect" href="https://player.twitch.tv" />
<link rel="preconnect" href="https://7tv.io" />
<link rel="dns-prefetch" href="https://cdn.7tv.app" />

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(personLD)}
/>
{
  videoLD && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(videoLD)}
    />
  )
}
